L  = 1
mu = 1
t = 0
T =1
dx = 0.01
dt = 0.01 #we can't just pick any values for dx and dt. If the speed of 
#your wave is such that it moves the distance dx in less time than dt, it blows up.
R = dt**2*T/(dx**2*mu)


# Generate spatial points
xt = 0
x = []

while xt < L:
    x = x + [xt]
    xt = xt + dx

#print(x)

# Initialize three lists with zeros
fnew = []  # k+1 (next time step)
fnow = []  # k   (current time step)
fold = []  # k-1 (previous time step)

for i in range(len(x)):
    fnew = np.zeros(len(x))  
    fnow = np.zeros(len(x))  
    fold = np.zeros(len(x)) 

#two copies of the initial string shape, so the simulation has both the current and previous values it needs to begin calculating motion.

for i in range(len(x)):
    if x[i] < L/2:
        fnow[i] = 0.01 * (np.sin(2 * np.pi * x[i] / L))**2  # to satisfy the same zero-displacement and zero-slope conditions
        
fold = fnow.copy()

plt.figure(figsize=(5, 2))
plt.plot(x, fnow)
plt.xlabel('x')
plt.ylabel('f')
plt.show()

while t < 2:
    fdata = []

    for i in range(1, len(x)-1):              #runs from 1 to 99 excludes 0 and 100
        
        fnew[i] = R * (fnow[i+1] + fnow[i-1] - 2*fnow[i]) - fold[i] + 2*fnow[i]

       # Free left endpoint  # CHANGES

    fnew[0] = (
        2*fnow[0] - fold[0]
        + 2*R*(fnow[1] - fnow[0])
    )  

    # Free right endpoint 

    fnew[-1] = (
        2*fnow[-1] - fold[-1]
        + 2*R*(fnow[-2] - fnow[-1])
    )  # CHANGES
      
    fold = fnow.copy()
    fnow = fnew.copy() 
    

 
         #  Advance to the next shape.

    for i in range(len(x)):
        
        fdata = fdata + [[x[i], fnew[i]]]


    t = t + dt
    
    # Update graph
    clear_output(wait=True)
    plt.figure(figsize=(10,6))
    plt.plot(x, fnew, color='blue')
    
    plt.xlabel('x')
    plt.ylabel('Displacement')
    plt.title(f'Time = {t:.2f}')
    
    plt.ylim(-0.02, 0.02)
    
    display(plt.gcf())
    plt.close()

    time.sleep(0.01)







        
